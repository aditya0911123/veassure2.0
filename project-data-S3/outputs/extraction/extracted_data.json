{
  "metadata": {
    "title": "Pet Store API",
    "version": "2.1.0",
    "description": "A comprehensive pet store API for managing pets, orders, and customers.",
    "contact": {
      "name": "Pet Store Support",
      "email": "support@petstore.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "servers": [
      {
        "url": "https://api.petstore.com/v2",
        "description": "Production server"
      },
      {
        "url": "https://staging.petstore.com/v2",
        "description": "Staging server"
      }
    ],
    "tags": [
      {
        "name": "Pets",
        "description": "Operations for managing pets"
      },
      {
        "name": "Orders",
        "description": "Operations for managing orders"
      },
      {
        "name": "Customers",
        "description": "Operations for managing customers"
      }
    ]
  },
  "security": {
    "schemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token. Include in Authorization header."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for admin operations."
      }
    },
    "global_requirements": [
      {
        "BearerAuth": []
      }
    ]
  },
  "endpoints": [
    {
      "path": "/pets",
      "method": "GET",
      "operationId": "listPets",
      "summary": "List all pets",
      "description": "Returns a paginated list of all pets available in the store. Supports filtering by status and species.",
      "tags": [
        "Pets"
      ],
      "security": "inherits_global",
      "parameters": [
        {
          "name": "status",
          "in": "query",
          "description": "Filter pets by availability status",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "available",
              "pending",
              "sold"
            ],
            "default": "available"
          }
        },
        {
          "name": "species",
          "in": "query",
          "description": "Filter pets by species",
          "required": false,
          "schema": {
            "type": "string",
            "example": "dog"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "description": "Maximum number of pets to return",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        {
          "name": "X-Request-ID",
          "in": "header",
          "description": "Optional request tracking ID",
          "required": false,
          "schema": {
            "type": "string",
            "example": "req-abc-123"
          }
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "Paginated list of pets returned successfully",
          "content": {
            "application/json": {
              "schema": "PetListResponse",
              "examples": {
                "dogExample": {
                  "summary": "Example with a dog",
                  "value": {
                    "data": [
                      {
                        "id": 1,
                        "name": "Buddy",
                        "species": "dog",
                        "breed": "Labrador",
                        "status": "available",
                        "price": 299.99
                      }
                    ],
                    "total": 1,
                    "page": 1
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "Invalid query parameters supplied",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        },
        "401": {
          "description": "Unauthorized - missing or invalid Bearer token",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        },
        "500": {
          "description": "Internal server error",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    },
    {
      "path": "/pets",
      "method": "POST",
      "operationId": "createPet",
      "summary": "Create a new pet",
      "description": "Adds a new pet to the store inventory. Requires ADMIN role.",
      "tags": [
        "Pets"
      ],
      "security": [
        {
          "BearerAuth": []
        },
        {
          "ApiKeyAuth": []
        }
      ],
      "parameters": [],
      "request_body": {
        "required": true,
        "description": "Pet object to be added to the store",
        "content": {
          "application/json": {
            "schema": "CreatePetRequest",
            "example": {
              "name": "Max",
              "species": "dog",
              "breed": "Golden Retriever",
              "age": 2,
              "price": 499.99,
              "status": "available",
              "tags": [
                "friendly",
                "trained"
              ]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Pet created successfully",
          "content": {
            "application/json": {
              "schema": "Pet"
            }
          }
        },
        "400": {
          "description": "Invalid pet data supplied",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        },
        "401": {
          "description": "Unauthorized",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        },
        "403": {
          "description": "Forbidden - insufficient permissions",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    },
    {
      "path": "/pets/{petId}",
      "method": "GET",
      "operationId": "getPetById",
      "summary": "Get pet by ID",
      "description": "Returns a single pet by its unique identifier.",
      "tags": [
        "Pets"
      ],
      "security": "inherits_global",
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "description": "Unique identifier of the pet",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64",
            "example": 1
          }
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "Pet returned successfully",
          "content": {
            "application/json": {
              "schema": "Pet"
            }
          }
        },
        "404": {
          "description": "Pet not found",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        },
        "500": {
          "description": "Internal server error",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    },
    {
      "path": "/pets/{petId}",
      "method": "PUT",
      "operationId": "updatePet",
      "summary": "Update a pet",
      "description": "Updates all fields of an existing pet. Partial updates not supported \u2014 use PATCH instead.",
      "tags": [
        "Pets"
      ],
      "security": "inherits_global",
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "description": "Unique identifier of the pet to update",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "request_body": {
        "required": true,
        "content": {
          "application/json": {
            "schema": "UpdatePetRequest"
          }
        }
      },
      "responses": {
        "200": {
          "description": "Pet updated successfully",
          "content": {
            "application/json": {
              "schema": "Pet"
            }
          }
        },
        "400": {
          "description": "Invalid data supplied",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        },
        "404": {
          "description": "Pet not found",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    },
    {
      "path": "/pets/{petId}",
      "method": "DELETE",
      "operationId": "deletePet",
      "summary": "Delete a pet",
      "description": "Permanently removes a pet from the store inventory. This action cannot be undone.",
      "tags": [
        "Pets"
      ],
      "security": "inherits_global",
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "description": "Unique identifier of the pet to delete",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "request_body": null,
      "responses": {
        "204": {
          "description": "Pet deleted successfully \u2014 no content returned"
        },
        "404": {
          "description": "Pet not found",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    },
    {
      "path": "/pets/{petId}",
      "method": "PATCH",
      "operationId": "patchPet",
      "summary": "Partially update a pet",
      "description": "Updates one or more fields of an existing pet without requiring the full object.",
      "tags": [
        "Pets"
      ],
      "security": "inherits_global",
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "request_body": {
        "required": true,
        "content": {
          "application/json": {
            "schema": "PatchPetRequest"
          }
        }
      },
      "responses": {
        "200": {
          "description": "Pet patched successfully",
          "content": {
            "application/json": {
              "schema": "Pet"
            }
          }
        },
        "404": {
          "description": "Pet not found",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    },
    {
      "path": "/orders",
      "method": "POST",
      "operationId": "placeOrder",
      "summary": "Place an order",
      "description": "Places a new order for one or more pets. Validates pet availability before confirming.",
      "tags": [
        "Orders"
      ],
      "security": "inherits_global",
      "parameters": [],
      "request_body": {
        "required": true,
        "content": {
          "application/json": {
            "schema": "CreateOrderRequest",
            "example": {
              "customerId": 42,
              "items": [
                {
                  "petId": 1,
                  "quantity": 1
                }
              ],
              "shippingAddress": {
                "street": "123 Main St",
                "city": "Springfield",
                "state": "IL",
                "zip": "62701",
                "country": "US"
              }
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Order placed successfully",
          "content": {
            "application/json": {
              "schema": "Order"
            }
          }
        },
        "400": {
          "description": "Invalid order data or pet unavailable",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        },
        "404": {
          "description": "Pet or customer not found",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    },
    {
      "path": "/orders/{orderId}",
      "method": "GET",
      "operationId": "getOrderById",
      "summary": "Get order by ID",
      "description": "Returns full order details including line items and shipping information.",
      "tags": [
        "Orders"
      ],
      "security": [],
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64",
            "example": 100
          }
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "Order returned successfully",
          "content": {
            "application/json": {
              "schema": "Order"
            }
          }
        },
        "404": {
          "description": "Order not found",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    },
    {
      "path": "/customers/{customerId}",
      "method": "GET",
      "operationId": "getCustomerById",
      "summary": "Get customer by ID",
      "description": "Returns a customer profile. Customers can only access their own profile unless they have ADMIN role.",
      "tags": [
        "Customers"
      ],
      "security": "inherits_global",
      "parameters": [
        {
          "name": "customerId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64",
            "example": 42
          }
        },
        {
          "name": "X-Correlation-ID",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string",
            "example": "corr-xyz-789"
          }
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "Customer profile returned successfully",
          "content": {
            "application/json": {
              "schema": "Customer"
            }
          }
        },
        "403": {
          "description": "Forbidden - cannot access another customer's profile",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        },
        "404": {
          "description": "Customer not found",
          "content": {
            "application/json": {
              "schema": "ErrorResponse"
            }
          }
        }
      }
    }
  ],
  "schemas": {
    "BaseEntity": {
      "type": "object",
      "description": "Base fields shared by all entities",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Auto-generated unique identifier",
          "example": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation",
          "example": "2026-01-01T00:00:00Z"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last update",
          "example": "2026-01-15T12:00:00Z"
        }
      },
      "required": [
        "id"
      ]
    },
    "Pet": {
      "allOf": [
        "BaseEntity",
        {
          "type": "object",
          "description": "A pet available in the store",
          "properties": {
            "name": {
              "type": "string",
              "description": "Pet name",
              "example": "Buddy"
            },
            "species": {
              "type": "string",
              "description": "Animal species",
              "enum": [
                "dog",
                "cat",
                "bird",
                "rabbit",
                "fish",
                "other"
              ],
              "example": "dog"
            },
            "breed": {
              "type": "string",
              "description": "Breed of the animal",
              "example": "Labrador"
            },
            "age": {
              "type": "integer",
              "description": "Age in years",
              "minimum": 0,
              "maximum": 30,
              "example": 3
            },
            "price": {
              "type": "number",
              "format": "float",
              "description": "Sale price in USD",
              "minimum": 0,
              "example": 299.99
            },
            "status": {
              "type": "string",
              "enum": [
                "available",
                "pending",
                "sold"
              ],
              "description": "Current availability status",
              "example": "available"
            },
            "tags": {
              "type": "array",
              "description": "Descriptive tags for the pet",
              "items": {
                "type": "string"
              },
              "example": [
                "friendly",
                "vaccinated"
              ]
            },
            "medicalRecord": "MedicalRecord",
            "owner": {
              "oneOf": [
                "Customer",
                {
                  "type": "object",
                  "properties": {
                    "storeName": {
                      "type": "string",
                      "description": "Name of the store currently holding the pet"
                    }
                  }
                }
              ],
              "description": "Current owner \u2014 either a Customer or the store itself"
            }
          },
          "required": [
            "name",
            "species",
            "status",
            "price"
          ]
        }
      ]
    },
    "MedicalRecord": {
      "type": "object",
      "description": "Medical history and vaccination records for a pet",
      "properties": {
        "vaccinated": {
          "type": "boolean",
          "description": "Whether the pet is fully vaccinated",
          "example": true
        },
        "neutered": {
          "type": "boolean",
          "description": "Whether the pet is neutered/spayed",
          "example": false
        },
        "lastCheckup": {
          "type": "string",
          "format": "date",
          "description": "Date of last veterinary checkup",
          "example": "2026-03-15"
        },
        "conditions": {
          "type": "array",
          "description": "List of known medical conditions",
          "items": {
            "type": "string"
          },
          "example": [
            "hip dysplasia"
          ]
        },
        "veterinarian": "Veterinarian"
      }
    },
    "Veterinarian": {
      "type": "object",
      "description": "Veterinarian assigned to a pet",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Vet ID",
          "example": 10
        },
        "name": {
          "type": "string",
          "description": "Full name of the veterinarian",
          "example": "Dr. Sarah Johnson"
        },
        "clinic": {
          "type": "string",
          "description": "Clinic name",
          "example": "Happy Paws Clinic"
        }
      }
    },
    "Customer": {
      "allOf": [
        "BaseEntity",
        {
          "type": "object",
          "description": "A registered customer of the pet store",
          "properties": {
            "firstName": {
              "type": "string",
              "description": "Customer first name",
              "example": "Jane"
            },
            "lastName": {
              "type": "string",
              "description": "Customer last name",
              "example": "Doe"
            },
            "email": {
              "type": "string",
              "format": "email",
              "description": "Customer email address",
              "example": "jane.doe@example.com"
            },
            "phone": {
              "type": "string",
              "description": "Customer phone number",
              "example": "+1-555-0100"
            },
            "address": "Address"
          },
          "required": [
            "firstName",
            "lastName",
            "email"
          ]
        }
      ]
    },
    "Address": {
      "type": "object",
      "description": "Physical address",
      "properties": {
        "street": {
          "type": "string",
          "description": "Street address",
          "example": "123 Main St"
        },
        "city": {
          "type": "string",
          "description": "City name",
          "example": "Springfield"
        },
        "state": {
          "type": "string",
          "description": "State or province code",
          "example": "IL"
        },
        "zip": {
          "type": "string",
          "description": "Postal/ZIP code",
          "example": "62701"
        },
        "country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code",
          "example": "US"
        }
      },
      "required": [
        "street",
        "city",
        "country"
      ]
    },
    "Order": {
      "allOf": [
        "BaseEntity",
        {
          "type": "object",
          "description": "A customer order for one or more pets",
          "properties": {
            "customerId": {
              "type": "integer",
              "format": "int64",
              "description": "ID of the customer who placed the order",
              "example": 42
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "confirmed",
                "shipped",
                "delivered",
                "cancelled"
              ],
              "description": "Current order status",
              "example": "confirmed"
            },
            "items": {
              "type": "array",
              "description": "Line items in the order",
              "items": "OrderItem"
            },
            "shippingAddress": "Address",
            "totalAmount": {
              "type": "number",
              "format": "float",
              "description": "Total order amount in USD",
              "example": 299.99
            },
            "payment": {
              "anyOf": [
                "CreditCardPayment",
                "BankTransferPayment"
              ],
              "description": "Payment details \u2014 either credit card or bank transfer"
            }
          },
          "required": [
            "customerId",
            "status",
            "items",
            "shippingAddress"
          ]
        }
      ]
    },
    "OrderItem": {
      "type": "object",
      "description": "A single line item in an order",
      "properties": {
        "petId": {
          "type": "integer",
          "format": "int64",
          "description": "ID of the pet being ordered",
          "example": 1
        },
        "quantity": {
          "type": "integer",
          "description": "Number of units",
          "minimum": 1,
          "example": 1
        },
        "unitPrice": {
          "type": "number",
          "format": "float",
          "description": "Price per unit at time of order",
          "example": 299.99
        }
      },
      "required": [
        "petId",
        "quantity",
        "unitPrice"
      ]
    },
    "CreditCardPayment": {
      "type": "object",
      "description": "Credit card payment details",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "credit_card"
          ],
          "example": "credit_card"
        },
        "last4": {
          "type": "string",
          "description": "Last 4 digits of the card",
          "example": "4242"
        },
        "brand": {
          "type": "string",
          "enum": [
            "visa",
            "mastercard",
            "amex",
            "discover"
          ],
          "description": "Card brand",
          "example": "visa"
        },
        "expiryMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "example": 12
        },
        "expiryYear": {
          "type": "integer",
          "minimum": 2024,
          "example": 2028
        }
      },
      "required": [
        "type",
        "last4",
        "brand"
      ]
    },
    "BankTransferPayment": {
      "type": "object",
      "description": "Bank transfer payment details",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "bank_transfer"
          ],
          "example": "bank_transfer"
        },
        "bankName": {
          "type": "string",
          "description": "Name of the bank",
          "example": "Chase"
        },
        "accountLast4": {
          "type": "string",
          "description": "Last 4 digits of the bank account",
          "example": "6789"
        }
      },
      "required": [
        "type",
        "bankName",
        "accountLast4"
      ]
    },
    "CreatePetRequest": {
      "type": "object",
      "description": "Request body for creating a new pet",
      "properties": {
        "name": {
          "type": "string",
          "description": "Pet name",
          "example": "Max"
        },
        "species": {
          "type": "string",
          "enum": [
            "dog",
            "cat",
            "bird",
            "rabbit",
            "fish",
            "other"
          ],
          "example": "dog"
        },
        "breed": {
          "type": "string",
          "example": "Golden Retriever"
        },
        "age": {
          "type": "integer",
          "minimum": 0,
          "example": 2
        },
        "price": {
          "type": "number",
          "format": "float",
          "minimum": 0,
          "example": 499.99
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "pending",
            "sold"
          ],
          "example": "available"
        },
        "tags": {
          "type": "array",
          "items": {
