{
  "openapi": "3.0.3",
  "info": {
    "title": "Fleet API",
    "version": "1.0.0",
    "description": "Tests allOf-based schema composition/inheritance, two levels deep."
  },
  "paths": {
    "/vehicles": {
      "get": {
        "operationId": "listVehicles",
        "responses": {
          "200": {
            "description": "All vehicles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Vehicle" }
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/cars": {
      "get": {
        "operationId": "listCars",
        "responses": {
          "200": {
            "description": "All cars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Car" }
                }
              }
            }
          }
        }
      }
    },
    "/vehicles/sports-cars": {
      "get": {
        "operationId": "listSportsCars",
        "responses": {
          "200": {
            "description": "All sports cars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SportsCar" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Vehicle": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "make": { "type": "string" },
          "model": { "type": "string" }
        },
        "required": ["id", "make", "model"]
      },
      "Car": {
        "allOf": [
          { "$ref": "#/components/schemas/Vehicle" },
          {
            "type": "object",
            "properties": {
              "doors": { "type": "integer" },
              "fuelType": { "type": "string", "enum": ["petrol", "diesel", "electric", "hybrid"] }
            }
          }
        ]
      },
      "SportsCar": {
        "allOf": [
          { "$ref": "#/components/schemas/Car" },
          {
            "type": "object",
            "properties": {
              "topSpeedKph": { "type": "number" },
              "zeroToHundredSeconds": { "type": "number" }
            },
            "required": ["topSpeedKph"]
          }
        ]
      }
    }
  }
}
